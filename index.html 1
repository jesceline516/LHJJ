  <script src="https://unpkg.com/ionicons@5.0.0/dist/ionicons.js"></script>
  <style>
    * {
      margin: 0; padding: 0; box-sizing: border-box;
    }

    body {
      font-family: 'Raleway', sans-serif;
      background: linear-gradient(135deg, #e0f2f1, #ffffff);
      color: #333;
      overflow-x: hidden;
    }

    header {
      background: linear-gradient(to right, #43a047, #66bb6a);
      color: white;
      padding: 60px 20px;
      text-align: center;
      animation: fadeIn 1s ease-in;
    }

    nav ul {
      display: flex;
      justify-content: center;
      gap: 30px;
      list-style: none;
      margin-bottom: 20px;
    }

    nav a {
      text-decoration: none;
      color: #fff;
      font-weight: bold;
      transition: color 0.3s;
    }

    nav a:hover {
      color: #dcedc8;
    }

    .hero-text h1 {
      font-size: 42px;
      margin-bottom: 10px;
    }

    .hero-text p {
      font-size: 20px;
      margin-bottom: 20px;
    }

    .btn {
      background-color: white;
      color: #2e7d32;
      padding: 10px 25px;
      border-radius: 25px;
      font-weight: bold;
      transition: transform 0.3s, background 0.3s;
      display: inline-block;
      text-decoration: none;
    }

    .btn:hover {
      background-color: #2e7d32;
      color: white;
      transform: scale(1.05);
    }

    main {
      max-width: 900px;
      margin: 40px auto;
      padding: 20px;
    }

    .card {
      background: white;
      padding: 30px;
      border-radius: 12px;
      box-shadow: 0 6px 20px rgba(0, 0, 0, 0.05);
      margin-bottom: 30px;
      animation: slideUp 0.8s ease both;
    }

    .card h2 {
      color: #2e7d32;
      margin-bottom: 15px;
    }

    .card p, .card li, .card table {
      line-height: 1.6;
    }

    ul.timeline {
      list-style: none;
      padding-left: 20px;
      border-left: 4px solid #81c784;
    }

    ul.timeline li {
      margin-bottom: 10px;
      position: relative;
    }

    ul.timeline li::before {
      content: '';
      position: absolute;
      width: 12px;
      height: 12px;
      background: #388e3c;
      border-radius: 50%;
      left: -10px;
      top: 6px;
    }

    table {
      width: 100%;
      border-collapse: collapse;
    }

    table th, table td {
      padding: 10px;
      text-align: left;
    }

    .sosmed-icons a {
      display: flex;
      align-items: center;
      gap: 10px;
      margin: 8px 0;
      color: #2e7d32;
      font-weight: 500;
      text-decoration: none;
      transition: transform 0.3s;
    }

    .sosmed-icons a:hover {
      transform: translateX(5px);
      color: #1b5e20;
    }

    footer {
      background: #a5d6a7;
      text-align: center;
      padding: 20px;
      color: #2e7d32;
      font-weight: bold;
    }

    /* Animasi */
    @keyframes fadeIn {
      from {opacity: 0;} to {opacity: 1;}
    }

    @keyframes slideUp {
      from {
        transform: translateY(40px);
        opacity: 0;
      }
      to {
        transform: translateY(0);
        opacity: 1;
      }
    }
  </style>
</head>

